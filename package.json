{
  "name": "ubiquiti2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "displayName": "Ubiquiti2",
  "description": "Monitor Ubiquiti network activity and health in Cribl.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "package": "npm run build && cribl-app-package",
    "deploy": "cribl-app-deploy",
    "inspect:pack": "cribl-app-inspect",
    "release:evidence": "cribl-app-release-evidence",
    "security:static": "cribl-app-security",
    "lint": "eslint . --max-warnings=0",
    "verify": "npm run lint && npm test && npx tsc --noEmit",
    "audit": "npm audit --audit-level=moderate && npm audit --omit=dev --audit-level=low",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@capra/core": "^1.5.0",
    "@criblio/app-utils": "^0.8.2",
    "d3-array": "^3.2.0",
    "d3-scale": "^4.0.0",
    "d3-shape": "^3.2.0",
    "d3-time-format": "^4.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-time": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@criblio/app-tooling": "^0.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.45.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright-core": "^1.45.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
